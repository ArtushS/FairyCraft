# Development defaults (safe for local startup)
PORT=8080
NODE_ENV=development
AUTH_REQUIRED=false
APPCHECK_REQUIRED=false
MOCK_ENGINE=true
STORE_DISABLED=true
POLICY_TTL_MS=60000
REQUEST_TIMEOUT_MS=20000
GLOBAL_RATE_LIMIT_PER_MIN=120
RATE_ENTRY_TTL_MS=120000
RATE_MAP_CAP=10000
STT_RATE_LIMIT_PER_MIN=30
VOICEMAKER_API_KEY=5991fea0-0a69-11f1-8770-c56efd80764d

# VOICEMAKER_API_KEY: API key for Voicemaker TTS/STT service (https://developer.voicemaker.in)
# Enables the following proxy endpoints:
#   POST /v1/tts/voicemaker - Convert text to speech (forwards to https://developer.voicemaker.in/api/v1/voice/convert)
#   POST /v1/tts/voicemaker/voices - List available voices (forwards to https://developer.voicemaker.in/api/v1/voice/list)
# The Flutter client calls these endpoints via TTS_PROXY_URL instead of calling Voicemaker directly.
# This keeps the API key server-side and secure.
#
# SECURITY WARNING: This key provides access to the Voicemaker service quota.
# In production, use environment-variable-based secrets management (not hardcoded in .env).
# DO NOT commit sensitive keys to source control.

# Vertex / Cloud Run integration (fill for production)
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=
GEMINI_MODEL=gemini-2.0-flash
VERTEX_IMAGE_MODEL=
STORAGE_BUCKET=
