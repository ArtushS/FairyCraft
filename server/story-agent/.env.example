# Development defaults (safe for local startup)
PORT=8080
NODE_ENV=development
AUTH_REQUIRED=false
APPCHECK_REQUIRED=false
MOCK_ENGINE=true
STORE_DISABLED=true
POLICY_TTL_MS=60000
REQUEST_TIMEOUT_MS=20000
GLOBAL_RATE_LIMIT_PER_MIN=120
RATE_ENTRY_TTL_MS=120000
RATE_MAP_CAP=10000

# Vertex / Cloud Run integration (fill for production)
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=
GEMINI_MODEL=gemini-2.0-flash
VERTEX_IMAGE_MODEL=
STORAGE_BUCKET=
