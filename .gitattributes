# Enforce LF for text files across repo, allow CRLF for typical Windows scripts
* text=auto eol=lf

# Keep CRLF for Windows batch and PowerShell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should use LF
*.sh text eol=lf

# Markdown and YAML files: LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Don't treat build outputs or binary files as text
build/** -text
bin/** -text
ios/Flutter/** -text
windows/**/flutter/** -text
**/*.png -text
**/*.jpg -text
**/*.jpeg -text
**/*.gif -text
**/*.ico -text
